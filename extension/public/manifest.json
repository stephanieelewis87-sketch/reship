{
  "manifest_version": 3,
  "name": "SellSync",
  "description": "Brings your sold orders and shipping labels from Poshmark, Mercari, Depop, Vinted and Whatnot into SellSync.",
  "version": "0.7.0",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" },
    "default_popup": "popup.html",
    "default_title": "SellSync"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "scripting",
    "downloads",
    "cookies"
  ],
  "host_permissions": [
    "https://poshmark.com/*",
    "https://labels-poshmark-production.s3.us-west-2.amazonaws.com/*",
    "https://www.mercari.com/*",
    "https://www.depop.com/*",
    "https://webapi.depop.com/*",
    "https://www.vinted.com/*",
    "https://www.whatnot.com/*",
    "https://*.supabase.co/*"
  ]
}
