# Leave these empty to run Hubby in demo mode (data saved in this browser only).
# Fill them in from your Supabase project's Settings > API page to use real accounts and a shared database.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SellSource and live shows (see the README). Leave off until Stripe / LiveKit are set up.
# VITE_SELLSOURCE=on
# VITE_LIVE_SHOWS=on
